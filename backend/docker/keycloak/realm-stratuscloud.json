{
  "realm": "stratuscloud",
  "enabled": true,
  "displayName": "StratusCloud Local",
  "registrationAllowed": false,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "users": [
    {
      "username": "local-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "local-admin",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "stratuscloud-local",
      "name": "StratusCloud Local",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "claim.value": "00000000-0000-0000-0000-000000000001",
            "id.token.claim": "true",
            "jsonType.label": "String",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "global_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "claim.name": "global_roles",
            "claim.value": "[\"TENANT_ADMIN\"]",
            "id.token.claim": "true",
            "jsonType.label": "JSON",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
